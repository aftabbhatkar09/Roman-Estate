# Public site URL (used for the sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://roman-estate.vercel.app

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority

# NextAuth / Auth Secret
AUTH_SECRET=your_auth_secret_key_here

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email notifications (resend.com) — optional. Without RESEND_API_KEY set,
# new inquiries are simply not emailed; the contact form still works.
RESEND_API_KEY=your_resend_api_key
# Who receives the "new inquiry" email. Defaults to ADMIN_EMAIL if unset.
NOTIFICATION_EMAIL=admin@example.com
# Sender address. Must be on a domain verified in Resend for production use;
# defaults to Resend's testing address otherwise.
EMAIL_FROM=Roman Estate <onboarding@resend.dev>
